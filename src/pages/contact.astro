---
import Base from '../layouts/Base.astro';
import Contact from '../components/views/Contact.astro';

const title = 'Contact: AI Consultancy in South Jakarta | Nino Genio';
const description =
  'Talk to Nino Genio — WhatsApp, a free 30-minute discovery call, email, or visit our office in South Jakarta. AI consulting for startups and scale-ups.';
---

<Base locale="en" path="/contact" title={title} description={description}>
  <Contact locale="en" />
</Base>
