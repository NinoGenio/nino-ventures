---
import { content } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const chat = content[locale].work.chat;
---

<figure class="chat-card" aria-label={chat.title}>
  <div class="chat-head">
    <span class="chat-avatar"><img src="/nino-genio-icon.svg" alt="" width="26" height="26" /></span>
    <div>
      <strong>{chat.title}</strong>
      <small><span class="dot" aria-hidden="true"></span>{chat.status}</small>
    </div>
  </div>
  <div class="chat-body">
    {chat.bubbles.map((b) => <div class={`bubble ${b.from}`}>{b.text}</div>)}
  </div>
  <div class="chat-foot">
    <span class="chat-chip"><span class="dot green" aria-hidden="true"></span>{chat.chip}</span>
  </div>
</figure>
