---
import { content, href } from '../../i18n';
import type { Locale } from '../../i18n';
import { site } from '../../site';
import ContactBand from '../ContactBand.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale].services;

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: c.pillars.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: p.title,
      description: p.text,
      provider: { '@id': `${site.url}/#organization` },
      areaServed: ['Indonesia', 'Southeast Asia'],
    },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: locale === 'en' ? 'Home' : 'Beranda', item: `${site.url}${href(locale, 'index')}` },
    { '@type': 'ListItem', position: 2, name: c.eyebrow, item: `${site.url}${href(locale, 'services')}` },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.title}</h1>
    <p class="lede">{c.lede}</p>
  </div>
</section>

<div class="container"><hr class="rule" /></div>

<section class="section">
  <div class="container">
    <div class="pillars">
      {c.pillars.map((p) => (
        <article class="pillar">
          <span class="n">{p.n}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <ul class="edit-list">
            {p.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{c.engagement.eyebrow}</p>
        <h2>{c.engagement.title}</h2>
      </div>
      <p class="side">{c.engagement.side}</p>
    </div>
    <div class="steps">
      {c.engagement.steps.map((s, i) => (
        <div class:list={['step', i === 0 && 'step--lead']}>
          <span class="n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<ContactBand locale={locale} />
