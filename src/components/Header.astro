---
import { content, href, altPath } from '../i18n';
import type { Locale } from '../i18n';
import { site, BOOKING_URL } from '../site';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const c = content[locale].nav;
const alt = locale === 'en' ? 'ID' : 'EN';
const altHref = altPath(locale, path);
const ctaHref = href(locale, 'contact') + (BOOKING_URL ? '' : '#book');
---

<header class="site-header">
  <nav class="nav" aria-label={locale === 'en' ? 'Primary' : 'Utama'}>
    <a class="brand" href={href(locale, 'index')} aria-label="Nino Genio">
      <span class="brand-mark"><img src="/nino-genio-icon.svg" alt="" width="30" height="30" /></span>
      <span>Nino Genio</span>
    </a>

    <div class="nav-links">
      <a href={href(locale, 'services')}>{c.services}</a>
      <a href={href(locale, 'work')}>{c.work}</a>
      <a href={href(locale, 'about')}>{c.about}</a>
      <a href={href(locale, 'contact')}>{c.contact}</a>
    </div>

    <div style="display:flex; align-items:center; gap:12px;">
      <a class="lang" href={altHref} hreflang={locale === 'en' ? 'id' : 'en'}>{alt}</a>
      <a class="btn" href={ctaHref}>{c.cta}</a>

      <details class="nav-menu">
        <summary aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </summary>
        <div class="menu-pop">
          <a href={href(locale, 'services')}>{c.services}</a>
          <a href={href(locale, 'work')}>{c.work}</a>
          <a href={href(locale, 'about')}>{c.about}</a>
          <a href={href(locale, 'contact')}>{c.contact}</a>
        </div>
      </details>
    </div>
  </nav>
</header>
