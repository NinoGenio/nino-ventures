---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content, altPath } from '../i18n';
import type { Locale } from '../i18n';
import { site, BOOKING_URL } from '../site';

interface Props {
  locale: Locale;
  /** Page path without locale prefix, e.g. '/' or '/services'. */
  path: string;
  title: string;
  description: string;
}

const { locale, path, title, description } = Astro.props;
const c = content[locale];
const canonical = locale === 'en' ? `${site.url}${path}` : `${site.url}/id${path}`;
const englishUrl = locale === 'en' ? path : altPath(locale, path);
const indoUrl = locale === 'en' ? altPath(locale, path) : path;
const ctaHref = locale === 'en' ? '/contact' : '/id/contact';
const ctaLink = BOOKING_URL ?? `${ctaHref}#book`;
const isHome = path === '/';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.legal,
  alternateName: site.name,
  url: site.url,
  logo: `${site.url}/nino-genio-logo.png`,
  email: site.email,
  telephone: '+628197967675',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plaza Aminta Lt. 5 / 504, Jl. Let. Jen. TB Simatupang Kav. 10',
    addressLocality: 'Jakarta Selatan',
    addressRegion: 'DKI Jakarta',
    postalCode: '12310',
    addressCountry: 'ID',
  },
  areaServed: ['Indonesia', 'Southeast Asia'],
  sameAs: [site.github, site.linkedin],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+628197967675',
      contactType: 'sales',
      availableLanguage: ['en', 'id'],
    },
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  description:
    'AI consultancy in Jakarta putting AI to work in production for startups and scale-ups.',
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#organization` },
};
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'id'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${site.url}${englishUrl}`} />
    <link rel="alternate" hreflang="id" href={`${site.url}${indoUrl}`} />
    <link rel="alternate" hreflang="x-default" href={`${site.url}${englishUrl}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/nino-genio-logo.png`} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'id_ID'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'id_ID' : 'en_US'} />
    <meta name="theme-color" content="#faf9f6" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
  </head>
  <body>
    <Header locale={locale} path={path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      // Close the mobile menu after picking a destination.
      document.querySelectorAll('.nav-menu .menu-pop a').forEach((a) => {
        a.addEventListener('click', () => {
          (a.closest('details') as HTMLDetailsElement | null)?.removeAttribute('open');
        });
      });
    </script>
  </body>
</html>
